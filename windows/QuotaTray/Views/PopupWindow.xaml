<Window x:Class="QuotaTray.Views.PopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quota Tray"
        Width="344"
        SizeToContent="Manual"
        Height="400"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        UseLayoutRounding="True"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="12">
    <Window.Resources>
        <!-- A thin overlay-style scroll bar, like the Mac panel's: a rounded thumb and nothing else. -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8" />
            <Setter Property="MinWidth" Value="8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True" Width="8">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border CornerRadius="3" Margin="1,2,1,2" Background="{DynamicResource ScrollThumbBrush}" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <!-- The margin leaves room for the drop shadow inside the transparent window. -->
    <Border x:Name="Frame" Margin="12" CornerRadius="13" BorderThickness="1" ClipToBounds="False">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="3" Opacity="0.3" />
        </Border.Effect>
        <!-- Tab cycles through the panel's controls instead of leaving it. -->
        <DockPanel x:Name="Root" LastChildFill="True" KeyboardNavigation.TabNavigation="Cycle" />
    </Border>
</Window>
